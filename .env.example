# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google tag (gtag.js) — client-side, so all of these must be NEXT_PUBLIC_.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads conversion ID, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Per-conversion-action labels (from Google Ads) consumed by lib/analytics.ts
NEXT_PUBLIC_GADS_LABEL_ACCOUNT_CREATED=
NEXT_PUBLIC_GADS_LABEL_EMAIL_CAPTURED=
NEXT_PUBLIC_GADS_LABEL_PRICING_VIEW=
